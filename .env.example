# Neon dashboard -> project -> Connection string (use the pooled connection string)
DATABASE_URL=

# Google Workspace mailbox to send notifications from
GMAIL_USER=
# myaccount.google.com/apppasswords (requires 2-Step Verification enabled on GMAIL_USER)
GMAIL_APP_PASSWORD=

# Comma-separated list of reviewer emails to notify on new requests
REVIEWER_NOTIFICATION_EMAILS=anna@bellaterrade.com,mike@bellaterrade.com,keith@bellaterrade.com

# Shared password for the /review area (pick one, share with Mike and Keith directly)
REVIEW_PASSWORD=

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# http://localhost:3000 locally; the deployed URL in production
APP_URL=http://localhost:3000
